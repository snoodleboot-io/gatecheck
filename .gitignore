# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
.installed.cfg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
# Root-level virtualenv only; anchored so it does NOT match src/gatecheck/env/
/env/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Compiled extensions produced by maturin develop
*.so
*.pyd

# ── Rust ──────────────────────────────────────────────────────
gatecheck-rs/target/
# Cargo.lock is kept — gatecheck-core ships as a binary wheel and we want
# reproducible release builds.

# ── Docs ──────────────────────────────────────────────────────
site/
docs/_build/
public/                 # Pages deploy artifact (marketing + docs), built in CI
docs-requirements.txt   # generated from pyproject [docs] extra by the Pages/CI jobs

# ── IDE / OS ──────────────────────────────────────────────────
.idea/
.vscode/
!.vscode/settings.json
.DS_Store
Thumbs.db

# ── Local secrets / scratch ───────────────────────────────────
.env
.env.local
# NB: .secrets.baseline IS committed — it is detect-secrets' shared allowlist,
# read by the check-secrets hook. It contains no secrets, only their locations.
*.log
scratch/

# ── Prompticorn session + transient run state ─────────────────
.prompticorn/sessions/
.prompticorn/run/
